TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Optional settings. Each line shows the default; remove the leading "# " to change it.

# Windows MCP launcher (scripts/finitact-mcp-windows.sh): the Windows venv python.exe, as a WSL path.
# FINITACT_WINDOWS_PYTHON=
# Seconds without keyboard or mouse input before Finitact sends synthetic input (ADR-0032).
# FINITACT_MIN_IDLE_SECONDS=1
# 0 builds Windows screen candidates from OCR only, without UI Automation (ADR-0036).
# FINITACT_SCREEN_UIA=1
# Processes that run_windows refuses as a target, because they may host the calling agent's own session.
# FINITACT_PROTECTED_PROCESSES=WindowsTerminal.exe,OpenConsole.exe,conhost.exe
# 1 lets run_windows send page goals in a browser window through the browser route (ADR-0051).
# FINITACT_WINDOW_BROWSER_ROUTE=
# agent restores the older browser loop instead of the shared one (ADR-0037).
# FINITACT_BROWSER_LOOP=
# Port of the local inspector.
# FINITACT_INSPECTOR_PORT=8766

# On-screen indicator during synthetic input (ADR-0010). Colors are #RRGGBB.
# Orb size in px (48 to 192), screen corner, and distance from the work-area edge in px.
# FINITACT_INDICATOR_SIZE=96
# FINITACT_INDICATOR_CORNER=bottom_right
# FINITACT_INDICATOR_MARGIN=24
# 0 shows still frames that change only with the state, with no motion.
# FINITACT_INDICATOR_ANIMATION=1
# Orb center, and orb edge while idle, observing, waiting on the decision provider, and sending input.
# FINITACT_INDICATOR_COLOR_CORE=#B2C4FF
# FINITACT_INDICATOR_COLOR_IDLE=#263096
# FINITACT_INDICATOR_COLOR_OBSERVE=#1A4AB0
# FINITACT_INDICATOR_COLOR_THINK=#4428A0
# FINITACT_INDICATOR_COLOR_ACT=#284CC8
# Spark for the external decision provider, lit while a request to it is in flight.
# FINITACT_INDICATOR_COLOR_PROVIDER=#FFB248
# Small orb over the target of each input. Empty follows FINITACT_INDICATOR_COLOR_ACT.
# FINITACT_INDICATOR_COLOR_RETICLE=
